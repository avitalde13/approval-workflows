# Copy to .env. Everything is optional for local development.
PORT=3000
APP_URL=http://localhost:3000
# DATABASE_URL=postgres://user:password@localhost:5432/approval_workflows
# SESSION_SECRET=change-me-to-a-long-random-string
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Email: "console" prints emails and lists them at /dev/outbox (development only).
# "none" sends nothing: Admins copy invite links instead (the production default). Or "brevo" / "resend".
EMAIL_PROVIDER=console
# EMAIL_FROM=no-reply@yourcompany.com
# EMAIL_FROM_NAME=Greenlight
# BREVO_API_KEY=
# RESEND_API_KEY=

# AI classification (optional). Without a key, only the rule-based checks run.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
